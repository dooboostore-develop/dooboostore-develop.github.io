{
  "name": "dooboostore-ecosystem-showcase",
  "version": "1.0.0",
  "description": "@dooboostore Ecosystem Showcase Site using Simple Web Component",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "webpack serve --mode development --config webpack.config.cjs",
    "build": "webpack --mode production --config webpack.config.cjs",
    "load-html": "webpack --config webpack.ssr.config.cjs && node dist-ssr/load-html.cjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@dooboostore/core": "workspace:*",
    "@dooboostore/core-web": "workspace:*",
    "@dooboostore/dom-parser": "workspace:*",
    "@dooboostore/simple-boot": "workspace:*",
    "@dooboostore/simple-boot-front": "workspace:*",
    "@dooboostore/simple-web-component": "workspace:*",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.0",
    "marked-highlight": "^2.1.1",
    "mermaid": "^12.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/marked": "^4.0.0",
    "@types/node": "^20.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "html-webpack-plugin": "^5.6.3",
    "playwright": "^1.63.0",
    "ts-loader": "^9.5.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  }
}
