{
  "name": "ssr-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build && concurrently -k -n front-end,back-end \"vite build --watch\" \"tsx watch back-end/index.ts\"",
    "build": "vite build",
    "start": "tsx back-end/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dooboostore/simple-web-component": "^1.0.54",
    "@dooboostore/simple-boot": "^1.0.59",
    "@dooboostore/simple-boot-http-server": "^1.0.30",
    "@dooboostore/simple-boot-http-server-ssr": "^1.0.21",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
